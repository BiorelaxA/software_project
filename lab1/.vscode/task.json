{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SpotBugs: Analyse",
      "type": "shell",
      "command": "spotbugs",
      "args": [
        "-textui",         
        "-effort:max",        
        "-high",             
        "${workspaceFolder}/target/classes" 
      ],
      "group": "build",
      "problemMatcher": {
        "owner": "java",
        "pattern": {
          "regexp": "^(.*\\.java):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    }
  ]
}
